{
  "name": "terminal-agent-local-server",
  "version": "1.0.0",
  "description": "Local file server for Terminal Agent",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/terminal-agent-local"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "chokidar": "^3.5.3",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}